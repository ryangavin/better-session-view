{
  "name": "openflow",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "description": "Session manager for large Ableton Live sets.",
  "license": "MIT",
  "author": "Ryan Gavin",
  "homepage": "https://github.com/ryangavin/better-session-view#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryangavin/better-session-view.git"
  },
  "bugs": {
    "url": "https://github.com/ryangavin/better-session-view/issues"
  },
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "core",
    "protocol",
    "widgets",
    "desktop",
    "set",
    "mix",
    "chart",
    "tools"
  ],
  "scripts": {
    "build": "npm run build:bridge && npm run build:device",
    "build:bridge": "node --disable-warning=ExperimentalWarning tools/build-bridge.ts && tsc -p bridge/tsconfig.v8.json",
    "app": "node --disable-warning=ExperimentalWarning tools/app.ts",
    "build:set": "node --disable-warning=ExperimentalWarning tools/app.ts build set",
    "build:mix": "node --disable-warning=ExperimentalWarning tools/app.ts build mix",
    "set": "node --disable-warning=ExperimentalWarning tools/app.ts run set",
    "mix": "node --disable-warning=ExperimentalWarning tools/app.ts run mix",
    "qa": "export OPENFLOW_QA=1 && rm -rf release && npm run build && npm run pack && npm run install:apps && npm run install:device",
    "pack": "node --disable-warning=ExperimentalWarning tools/app.ts pack",
    "pack:set": "node --disable-warning=ExperimentalWarning tools/app.ts pack set",
    "pack:mix": "node --disable-warning=ExperimentalWarning tools/app.ts pack mix",
    "pack:visuals": "node --disable-warning=ExperimentalWarning tools/app.ts pack visuals",
    "install:apps": "node --disable-warning=ExperimentalWarning tools/install-apps.ts",
    "install:device": "node --disable-warning=ExperimentalWarning tools/install-device.ts",
    "build:device": "node --disable-warning=ExperimentalWarning tools/build-device.ts",
    "build:widgets": "npm run build:types --workspace @openflow/widgets",
    "dev:check-palette": "node --disable-warning=ExperimentalWarning tools/check-palette.ts",
    "dev:check-singletons": "node --disable-warning=ExperimentalWarning tools/check-singletons.ts",
    "dev:mutate": "node --disable-warning=ExperimentalWarning tools/mutate.ts",
    "dev:version": "node --disable-warning=ExperimentalWarning tools/version.ts",
    "dev:record": "node --disable-warning=ExperimentalWarning tools/record-session.ts",
    "dev:diag": "node --disable-warning=ExperimentalWarning tools/diag.ts",
    "dev:responses": "node --disable-warning=ExperimentalWarning visuals/tools/responses-report.ts",
    "dev:node-manual": "node --disable-warning=ExperimentalWarning visuals/tools/generate-manual.ts",
    "dev:lom-scrape": "node --disable-warning=ExperimentalWarning tools/lom-reference.ts",
    "dev": "concurrently -k -n bridge,types,lom,set,bench,devices,vis-app,vis-ui,chart,chart-ui,mix -c cyan,blue,magenta,green,yellow,red,white,gray,magentaBright,blueBright,yellowBright \"node --disable-warning=ExperimentalWarning tools/dev-bridge.ts\" \"tsc -p bridge/tsconfig.node.json --noEmit --watch --preserveWatchOutput\" \"tsc -p bridge/tsconfig.v8.json --watch --preserveWatchOutput\" \"vite --config set/vite.config.ts\" \"vite --config widgets/vite.config.ts\" \"vite --config set/vite.bench.config.ts\" \"npm run dev:visuals-app\" \"vite --config visuals/vite.config.ts\" \"OPENFLOW_CHART_UI=http://127.0.0.1:5573 node --watch --disable-warning=ExperimentalWarning chart/server/index.ts\" \"vite --config chart/vite.config.ts\" \"npm run dev:mix-ui\"",
    "dev:set": "node --disable-warning=ExperimentalWarning tools/app.ts watch set",
    "dev:set-ui": "vite --config set/vite.config.ts",
    "dev:set-app": "node --disable-warning=ExperimentalWarning tools/app.ts dev set",
    "dev:mix": "node --disable-warning=ExperimentalWarning tools/app.ts watch mix",
    "dev:mix-ui": "vite --config mix/vite.config.ts",
    "dev:mix-app": "node --disable-warning=ExperimentalWarning tools/app.ts dev mix",
    "dev:widgets": "vite --config widgets/vite.config.ts",
    "dev:devices": "vite --config set/vite.bench.config.ts",
    "typecheck": "tsc -p bridge/tsconfig.node.json --noEmit && tsc -p bridge/tsconfig.v8.json --noEmit && tsc -p core/tsconfig.json && tsc -p widgets/tsconfig.json && tsc -p desktop/tsconfig.json && tsc -p set/tsconfig.json && tsc -p set/tsconfig.electron.json && tsc -p mix/tsconfig.json && tsc -p mix/tsconfig.electron.json && tsc -p visuals/tsconfig.electron.json && tsc -p tools/tsconfig.json && tsc -p visuals/tsconfig.json && tsc -p chart/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=html",
    "benchmark": "node --disable-warning=ExperimentalWarning tools/benchmark.ts",
    "postinstall": "cd bridge && npm install --no-audit --no-fund && cd ../visuals && npm install --ignore-scripts --no-audit --no-fund && npm run build:link && cd .. && npm run dev:check-singletons",
    "visuals": "node --disable-warning=ExperimentalWarning tools/app.ts run visuals",
    "visuals:browser": "node --disable-warning=ExperimentalWarning tools/visuals.ts",
    "build:visuals": "node --disable-warning=ExperimentalWarning tools/app.ts build visuals",
    "dev:visuals": "node --disable-warning=ExperimentalWarning tools/app.ts watch visuals",
    "dev:visuals-server": "node --disable-warning=ExperimentalWarning visuals/server/index.ts",
    "dev:visuals-ui": "vite --config visuals/vite.config.ts",
    "dev:visuals-app": "node --disable-warning=ExperimentalWarning tools/app.ts dev visuals",
    "dev:fake-live": "node --disable-warning=ExperimentalWarning visuals/tools/fake-live.ts",
    "build:chart": "vite build --config chart/vite.config.ts",
    "dev:chart": "node --watch --disable-warning=ExperimentalWarning chart/server/index.ts",
    "dev:chart-ui": "vite --config chart/vite.config.ts",
    "frames": "node --disable-warning=ExperimentalWarning tools/frames.ts",
    "footage:frames": "node --disable-warning=ExperimentalWarning tools/footage-frames.ts",
    "demo:mix": "node --disable-warning=ExperimentalWarning tools/mix-demo.ts"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "concurrently": "^10.0.5",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.12.0",
    "typescript": "^7.0.2",
    "typescript-syntax": "npm:typescript@5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fontsource-variable/recursive": "5.3.0",
    "@xyflow/react": "^12.11.5",
    "d3-hierarchy": "^3.1.2",
    "electron-updater": "^6.8.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "signalsmith-stretch": "^1.3.2"
  }
}
