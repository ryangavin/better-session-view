node_modules/
# generated: tsc output consumed directly by node.script and [v8]
bridge/bridge.js
bridge/lom.js
# generated: every module's build output — a vite build for the apps and the chart,
# tsc declarations for @openflow/widgets. Globbed rather than listed, because a new app
# that is otherwise a registry entry should not need a line here to stop being committed.
*/dist/
# generated: the Electron main, preload, server and icon
*/electron/dist/
# generated: packaged .app and .dmg — npm run pack
release/
# fetched, pinned and verified by mix/tools/prepare.ts: the uv that installs the
# Python engine on a user's machine. A binary, so it is downloaded rather than committed
mix/bin/
# generated: device binary + debug patcher
bridge/SessionBridge.amxd
bridge/SessionBridge.maxpat
# derived from Live at runtime
bridge/palette.json
bridge/palette.json.tmp
# the role vocabulary — yours, not the repo's
bridge/roles.json
bridge/roles.json.tmp
# the show — yours, not the repo's, and rewritten every time a number moves
visuals/scheme.json
# generated: the benches and the frame captures, which are not named dist/
visuals/bench-dist/
# the design-system sync toolkit and the bundle it builds — tooling, not source
widgets/.ds-sync/
widgets/ds-bundle/
# the user manual — its own repo (…wiki.git), cloned here so it edits alongside the code
wiki/
.DS_Store
# generated: vitest coverage report and ui — npm run test:coverage
coverage/
report/
visuals/frames-dist/
visuals/frames-out/
