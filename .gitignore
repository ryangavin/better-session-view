node_modules/
# generated: tsc output consumed directly by node.script and [v8]
bridge/bridge.js
bridge/lom.js
# generated: vite build output, served by the desktop app and inlined into the device
set/dist/
# generated: the Electron main and preload, bundled by tools/build-electron.ts
set/electron/dist/
# generated: vite build output (until the device stops serving it)
bridge/public/
# generated: device binary + debug patcher
bridge/SessionBridge.amxd
bridge/SessionBridge.maxpat
# derived from Live at runtime
bridge/palette.json
bridge/palette.json.tmp
# the role vocabulary — yours, not the repo's
bridge/roles.json
bridge/roles.json.tmp
# the show — yours, not the repo's, and rewritten every time a number moves
visuals/scheme.json
# generated: the renderer's vite build output, served by the visuals server
visuals/dist/
# generated: the chart's vite build output, served by the chart server
chart/dist/
# generated: tsc declarations for @openflow/widgets, built by npm run build:widgets
widgets/dist/
# the design-system sync toolkit and the bundle it builds — tooling, not source
widgets/.ds-sync/
widgets/ds-bundle/
# the user manual — its own repo (…wiki.git), cloned here so it edits alongside the code
wiki/
# generated: the gnosis architecture graph as a static site, deployed to Pages by graph.yml
_site/
.DS_Store
