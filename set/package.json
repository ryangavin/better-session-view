{
  "name": "@openflow/set",
  "version": "0.1.0-rc.4",
  "private": true,
  "author": "Ryan Gavin",
  "type": "module",
  "main": "electron/dist/main.cjs",
  "description": "set[flow]: the session manager — the clip grid, the mixer and the device chain, in React.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openflowfm/set.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning tools/app.ts build",
    "electron": "node --disable-warning=ExperimentalWarning tools/app.ts electron",
    "icons": "node --disable-warning=ExperimentalWarning tools/app.ts icons",
    "start": "node --disable-warning=ExperimentalWarning tools/app.ts run",
    "watch": "node --disable-warning=ExperimentalWarning tools/app.ts watch",
    "dev": "node --disable-warning=ExperimentalWarning tools/app.ts dev",
    "pack": "node --disable-warning=ExperimentalWarning tools/app.ts pack",
    "ui": "vite --config vite.config.ts",
    "bench": "vite --config vite.bench.config.ts",
    "record": "node --disable-warning=ExperimentalWarning tools/record-session.ts",
    "mutate": "node --disable-warning=ExperimentalWarning tools/mutate.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@openflow/core": "github:openflowfm/core#685db6fd1a8ba77bb8e575c66935a11fb56acce9",
    "@openflow/desktop": "git+https://github.com/openflowfm/desktop.git#ff1b05d0f003281c0f3a10e1c096926719cc4285",
    "@openflow/protocol": "github:openflowfm/protocol#918e52b61afcc9945d433a445557a3043e532af1",
    "@openflow/widgets": "git+https://github.com/openflowfm/widgets.git#dc356455e561c7eb9dce337a1e6b6810a5251fcb",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/ui": "5.0.0",
    "concurrently": "^10.0.5",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.0",
    "typescript": "^7.0.2",
    "typescript-syntax": "npm:typescript@5.9.3",
    "vite": "^8.2.2",
    "vitest": "5.0.0"
  },
  "allowScripts": {
    "github:openflowfm/desktop#ff1b05d0f003281c0f3a10e1c096926719cc4285": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": true
  }
}
